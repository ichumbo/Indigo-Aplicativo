# ==============================================================================
# DRAGONCORP — ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Versão: 1.0.0 | Plataformas: iOS (App Store) & Android (Google Play)
# ==============================================================================
# NUNCA insira dados de produção, chaves privadas ou senhas reais neste arquivo.
# Copie este arquivo para .env no ambiente de desenvolvimento ou configure
# os segredos diretamente no EAS Secrets e no painel seguro do servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICATIVO MOBILE (Variáveis Públicas - Expostas no Bundle do Expo)
# ------------------------------------------------------------------------------
# URL Base da API REST do DragonCorp Backend (deve usar HTTPS em produção)
EXPO_PUBLIC_API_URL=https://api.dragoncorp.app/api/v1

# Identificador do Ambiente (development | homologation | production)
EXPO_PUBLIC_APP_ENV=production

# Versão Canônica da Aplicação
EXPO_PUBLIC_APP_VERSION=1.0.0

# Product IDs Canônicos de Assinatura nas Lojas Oficiais
EXPO_PUBLIC_IAP_APPLE_MONTHLY=com.dragoncorp.pro.monthly
EXPO_PUBLIC_IAP_APPLE_ANNUAL=com.dragoncorp.pro.annual
EXPO_PUBLIC_IAP_GOOGLE_MONTHLY=dragoncorp_pro_monthly
EXPO_PUBLIC_IAP_GOOGLE_ANNUAL=dragoncorp_pro_annual

# URLs Oficiais de Termos, Privacidade e Suporte
EXPO_PUBLIC_TERMS_URL=https://dragoncorp.app/termos
EXPO_PUBLIC_PRIVACY_URL=https://dragoncorp.app/privacidade
EXPO_PUBLIC_SUPPORT_EMAIL=suporte@dragoncorp.app

# ------------------------------------------------------------------------------
# 2. EAS SECRETS (Configurados no Expo Application Services via CLI / Web)
# ------------------------------------------------------------------------------
# EAS Project ID (Configurado no app.json / EAS CLI)
# EAS_PROJECT_ID=be47a583-028c-46f0-8605-2c04ca87c516

# Apple StoreKit & App Store Connect (EAS Build / Submit Credentials)
# APPLE_ASC_API_KEY_ID=
# APPLE_ASC_API_ISSUER_ID=
# APPLE_ASC_API_KEY_P8_BASE64=
# APPLE_TEAM_ID=

# Google Play Service Account (EAS Build / Submit Credentials)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 3. BACKEND LARAVEL & BANCO DE DADOS (Privado - Servidor Apenas)
# ------------------------------------------------------------------------------
APP_NAME="DragonCorp Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dragoncorp.app

# Conexão de Banco de Dados de Produção
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dragoncorp_prod
DB_USERNAME=dragoncorp_user
DB_PASSWORD=

# Sessão e Autenticação Laravel Sanctum
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=portal.dragoncorp.app,dragoncorp.app
CORS_ALLOWED_ORIGINS=https://portal.dragoncorp.app,https://dragoncorp.app

# Chaves de Verificação de Recibos StoreKit & Google Play Billing (Server-Side)
APPLE_IAP_BUNDLE_ID=com.dragoncorp.app
APPLE_IAP_SHARED_SECRET=
APPLE_STOREKIT_KEY_ID=
APPLE_STOREKIT_ISSUER_ID=
APPLE_STOREKIT_PRIVATE_KEY_PATH=

GOOGLE_PLAY_PACKAGE_NAME=com.dragoncorp.app
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/var/secrets/google-play-service-account.json

# Notificações Push Expo / APNs / FCM (Server-Side)
EXPO_ACCESS_TOKEN=
