APP_NAME="DragonCorp Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexão padrão: SQLite (zero dependência externa).
# Para produção com MySQL, altere para mysql:
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dragoncorp
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App Store Server API (somente no servidor; nunca usar EXPO_PUBLIC_)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_BUNDLE_ID=com.dragoncorp.app
# Arquivo PEM da Apple Root CA - G3 obtido em https://www.apple.com/certificateauthority/
APPLE_IAP_ROOT_CERTIFICATE_PATH=

# RevenueCat: habilite depois de configurar App Store Connect e o webhook.
REVENUECAT_ENABLED=false
REVENUECAT_SECRET_API_KEY=
# Valor COMPLETO do cabeçalho configurado no painel (ex.: Bearer segredo-aleatorio)
REVENUECAT_WEBHOOK_AUTHORIZATION=
# ID do app Apple no RevenueCat (app...), não o bundle ID da Apple
REVENUECAT_APP_ID=
REVENUECAT_ENTITLEMENT=tier_pro
# Use sandbox em um backend separado para desenvolvimento/TestFlight.
REVENUECAT_ENVIRONMENT=production
# Webhook: POST /api/v1/webhooks/revenuecat
# Conecte os produtos mensal/anual ao entitlement tier_pro e offering default.
# Restore behavior: Keep with original App User ID.
