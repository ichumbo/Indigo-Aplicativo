{
  "name": "dragoncorp-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run --prefix web/frontend dev",
    "web": "expo start --web",
    "web:portal": "npm run --prefix web/frontend dev",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test tests/*.test.js",
    "lint": "expo lint",
    "test:composition": "node --test tests/body-composition-protocols.test.js",
    "test:functional": "node --test tests/functional-test-catalog.test.js",
    "test:cardio": "node --test tests/cardiorespiratory-protocols.test.js",
    "test:performance": "node --test tests/exercise-performance.test.js",
    "test:trainer-home": "node --test tests/trainer-home-store.test.js",
    "test:auth": "node --test tests/auth-store.test.js",
    "test:exercise-store": "node --test tests/exercise-store.test.js",
    "test:subscription": "node --test tests/subscription-freemium.test.js",
    "test:ai": "node --test tests/ai-assistant.test.js",
    "test:load-routes": "node scripts/route-load-test.js",
    "test:unit-integration": "node scripts/unit-integration-structure-test.js",
    "test:coverage": "node scripts/full-system-coverage-test.js",
    "verify:aab": "node scripts/verify-aab.js",
    "autocommit": "node scripts/auto-commit.js --watch",
    "autocommit:push": "node scripts/auto-commit.js --watch --push",
    "commit": "node scripts/auto-commit.js",
    "commit:push": "node scripts/auto-commit.js --push"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
