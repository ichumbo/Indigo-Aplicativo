{
  "expo": {
    "name": "DragonCorp",
    "slug": "dragoncorp-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dragoncorp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dragoncorp.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Permita usar a câmera para capturar fotos padronizadas de avaliação física e evolução postural.",
        "NSPhotoLibraryUsageDescription": "Permita selecionar fotos para registrar avaliações físicas e acompanhar comparações de evolução."
      }
    },
    "android": {
      "package": "com.dragoncorp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita selecionar fotos para registrar avaliações físicas e comparações de evolução.",
          "cameraPermission": "Permita usar a câmera para capturar fotos padronizadas da avaliação física."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-principal.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
